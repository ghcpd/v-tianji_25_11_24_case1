    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "jsdom": "^22.1.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
